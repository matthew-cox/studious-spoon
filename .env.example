# DEV ONLY — local credentials for docker compose. Never reuse these outside your machine.
COMPOSE_PROJECT_NAME=shortener

POSTGRES_SUPERUSER_PASSWORD=postgres-dev
MIGRATOR_DB_PASSWORD=migrator-dev
API_DB_PASSWORD=api-dev
PROCESSOR_DB_PASSWORD=processor-dev
ADMIN_DB_PASSWORD=admin-dev
KEYCLOAK_DB_PASSWORD=keycloak-dev

# Host port for Keycloak; the token issuer is http://localhost:${KEYCLOAK_HOST_PORT}/realms/shortener.
# Change both lines together if 8080 is taken on your machine.
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_URL=http://localhost:8080

KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin-dev
SHORTENER_ADMIN_CLIENT_SECRET=shortener-admin-dev-secret
# Signs the admin UI's short-lived login handshake cookie (>= 32 chars).
ADMIN_COOKIE_SECRET=dev-only-admin-cookie-secret-change-me-0001

# --- Optional overrides (defaults shown) ---
# Image tag / service.version; the Makefile sets it from `git rev-parse --short HEAD`.
# GIT_SHA=dev
# Force-reset seeded users' passwords on the next `make seed-users`.
# RESET_PASSWORDS=false
# Host-side endpoints used by `make e2e` and scripts/.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# SQS_ENDPOINT_URL=http://localhost:9324
# GRAFANA_URL=http://localhost:3000
# OTLP_HTTP_URL=http://localhost:4318
# Per-container memory guard-rails (docker compose mem_limit); raise if a container is OOM-killed.
# Run colima with at least `--memory 8`.
# POSTGRES_MEM_LIMIT=256m
# ELASTICMQ_MEM_LIMIT=256m
# KEYCLOAK_MEM_LIMIT=1g
# API_MEM_LIMIT=512m
# PROCESSOR_MEM_LIMIT=512m
# ADMIN_MEM_LIMIT=512m
# OTEL_LGTM_MEM_LIMIT=2g
